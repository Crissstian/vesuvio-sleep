# Copia in .env.local. Non committare mai i valori reali.

# Supabase: progetto "Vesuvio Sleep – nuovo sito" (ref bsojqhtidiwwzmzqtgde, Francoforte),
# separato dal progetto del sito attuale. La chiave pubblica si copia da
# Dashboard › Project Settings › API keys (publishable). La service role mai nel browser.
NEXT_PUBLIC_SUPABASE_URL=https://bsojqhtidiwwzmzqtgde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server (route handler / script di seed). Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Numero WhatsApp per le richieste, formato internazionale (+39…). Da confermare.
# Se vuoto si usa il setting admin; se manca anche quello il sito offre solo "Copia il riepilogo".
NEXT_PUBLIC_WHATSAPP_NUMBER=+39 366 121 8346

# URL del sito: lasciare vuoto nelle preview (niente canonical, robots noindex).
NEXT_PUBLIC_SITE_URL=

# Pagamenti: predisposti e DISATTIVATI. Non valorizzare senza autorizzazione.
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_PAYPAL_ENABLED=false
PAYMENTS_KLARNA_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
KLARNA_USERNAME=
KLARNA_PASSWORD=
